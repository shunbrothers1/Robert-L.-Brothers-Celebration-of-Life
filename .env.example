# This project's OWN Supabase project (Settings > API). Do not reuse any
# other app's Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# That's all the app needs at runtime — there is no service-role key in
# this app at all. Guest actions use the anon key + database functions;
# admin actions use the signed-in admin's own session under RLS.

# Optional — ONLY for the database integration tests (npm run test:db).
# Point these at a LOCAL (`supabase start`) or throwaway Supabase project,
# never production: the tests create users and events.
# CELEBRATION_TEST_SUPABASE_URL=http://127.0.0.1:54321
# CELEBRATION_TEST_ANON_KEY=
# CELEBRATION_TEST_SERVICE_ROLE_KEY=
